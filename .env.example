# Environment Configuration for SampleSource Pro

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database Configuration
DATABASE_URL=./backend/data/samplesource.db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# External API Keys (Replace with actual keys in production)
MUSICBRAINZ_USER_AGENT=SampleSourcePro/1.0.0 (contact@samplesourcepro.com)
ACRCLOUD_ACCESS_KEY=your-acrcloud-access-key
ACRCLOUD_ACCESS_SECRET=your-acrcloud-access-secret
SHAZAM_API_KEY=your-shazam-api-key

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./backend/uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Subscription/Payment Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
CORS_ORIGIN=http://localhost:5173
HELMET_ENABLED=true

# Feature Flags
ENABLE_AUDIO_ANALYSIS=true
ENABLE_REAL_TIME_NOTIFICATIONS=false
ENABLE_BATCH_PROCESSING=true
